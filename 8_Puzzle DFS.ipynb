def make_html_table(rows, title="Table"):
    """
    Tạo bảng HTML gọn, giống mẫu:
    Step / Node / State / Depth / Action Path / Children Added /
    Frontier Before Pop / Frontier After Expand / Reached / Note.
    """
    if not rows:
        return f"<p>Chưa có dữ liệu cho {html.escape(title)}.</p>"

    columns = list(rows[0].keys())

    width_map = {
        "Step": "58px",
        "Node": "95px",
        "State": "92px",
        "State Grid": "92px",
        "State Compact": "95px",
        "Depth": "70px",
        "Move": "90px",
        "Action Path": "170px",
        "Children Added": "210px",
        "Frontier Before Pop": "210px",
        "Frontier After Expand": "210px",
        "Reached": "210px",
        "Path Checking": "210px",
        "Note": "130px",
    }

    css = """
    <style>
        .custom-table-wrapper {
            overflow: auto;
            max-width: 100%;
            max-height: 560px;
            border: 1px solid #999;
            margin-top: 8px;
            margin-bottom: 18px;
            background: white;
        }
        table.custom-table {
            border-collapse: collapse;
            table-layout: fixed;
            min-width: 1280px;
            width: max-content;
            font-size: 14px;
        }
        table.custom-table th,
        table.custom-table td {
            border: 1px solid #777;
            padding: 8px 10px;
            vertical-align: top;
            text-align: left;
            line-height: 1.35;
        }
        table.custom-table th {
            background: #eeeeee;
            font-weight: bold;
            position: sticky;
            top: 0;
            z-index: 2;
        }
        table.custom-table tr:nth-child(even) {
            background: #fafafa;
        }
        .state-grid {
            font-family: monospace;
            white-space: pre;
            line-height: 1.55;
        }
        .long-cell {
            white-space: pre-line;
            overflow-wrap: anywhere;
            word-break: break-word;
        }
    </style>
    """

    html_text = css
    html_text += f"<h3>{html.escape(title)}</h3>"
    html_text += '<div class="custom-table-wrapper">'
    html_text += '<table class="custom-table">'

    html_text += "<colgroup>"
    for col in columns:
        width = width_map.get(col, "180px")
        html_text += f'<col style="width:{width};">'
    html_text += "</colgroup>"

    html_text += "<tr>"
    for col in columns:
        html_text += f"<th>{html.escape(str(col))}</th>"
    html_text += "</tr>"

    for row in rows:
        html_text += "<tr>"

        for col in columns:
            value = row[col]

            if col in ["State", "State Grid"]:
                cell = value
            else:
                cell = html.escape(str(value))

            html_text += f'<td class="long-cell">{cell}</td>'

        html_text += "</tr>"

    html_text += "</table></div>"

    return html_text


# ============================================================
# DFS CÁCH 1: STACK + REACHED TOÀN CỤC
# ============================================================

def dfs_way1(start, goal, max_depth=MAX_DEPTH):
    if not is_solvable(start, goal):
        return None, None, [], {
            "status": "unsolvable",
            "expanded": 0,
            "visited": 0,
            "depth": 0
        }

    stack = [(start, [])]
    reached_depth = {start: 0}

    expanded = 0
    trace = []

    while stack:
        frontier_before = format_stack(stack)

        current_state, path = stack.pop()
        expanded += 1

        current_depth = len(path)
        action_path = " → ".join([move for move, state in path]) if path else "Start"

        if current_state == goal:
            if len(trace) < MAX_TRACE_ROWS:
                trace.append({
                    "Step": expanded,
                    "Node": state_to_compact(current_state),
                    "State": state_to_grid_html(current_state),
                    "Depth": current_depth,
                    "Action Path": action_path,
                    "Children Added": "Không cần sinh con vì đã tới Goal",
                    "Frontier Before Pop": frontier_before,
                    "Frontier After Expand": format_stack(stack),
                    "Reached": format_state_list(reached_depth.keys()),
                    "Note": "Tìm thấy Goal"
                })

            solution_states = [start] + [state for move, state in path]
            solution_moves = [move for move, state in path]

            return solution_states, solution_moves, trace, {
                "status": "found",
                "expanded": expanded,
                "visited": len(reached_depth),
                "depth": current_depth
            }

        if current_depth >= max_depth:
            if len(trace) < MAX_TRACE_ROWS:
                trace.append({
                    "Step": expanded,
                    "Node": state_to_compact(current_state),
                    "State": state_to_grid_html(current_state),
                    "Depth": current_depth,
                    "Action Path": action_path,
                    "Children Added": "Không mở rộng vì đạt max depth",
                    "Frontier Before Pop": frontier_before,
                    "Frontier After Expand": format_stack(stack),
                    "Reached": format_state_list(reached_depth.keys()),
                    "Note": "Cắt nhánh"
                })
            continue

        neighbors = get_neighbors(current_state)

        children_added = []

        for move_name, next_state in neighbors:
            next_depth = current_depth + 1

            if next_state not in reached_depth or next_depth < reached_depth[next_state]:
                reached_depth[next_state] = next_depth
                children_added.append((move_name, next_state))

        for move_name, next_state in reversed(children_added):
            stack.append((next_state, path + [(move_name, next_state)]))

        children_text = " |\n".join(
            f"{move}: {state_to_compact(state)}"
            for move, state in children_added
        )

        if children_text == "":
            children_text = "Không có con mới"

        if len(trace) < MAX_TRACE_ROWS:
            trace.append({
                "Step": expanded,
                "Node": state_to_compact(current_state),
                "State": state_to_grid_html(current_state),
                "Depth": current_depth,
                "Action Path": action_path,
                "Children Added": children_text,
                "Frontier Before Pop": frontier_before,
                "Frontier After Expand": format_stack(stack),
                "Reached": format_state_list(reached_depth.keys()),
                "Note": "Đã mở rộng node"
            })

    return None, None, trace, {
        "status": "not_found",
        "expanded": expanded,
        "visited": len(reached_depth),
        "depth": max_depth
    }


# ============================================================
# DFS CÁCH 2: STACK + PATH CHECKING
# ============================================================

def dfs_way2(start, goal, max_depth=MAX_DEPTH):
    if not is_solvable(start, goal):
        return None, None, [], {
            "status": "unsolvable",
            "expanded": 0,
            "visited": 0,
            "depth": 0
        }

    stack = [(start, [])]

    expanded = 0
    generated = 1
    trace = []

    while stack:
        frontier_before = format_stack(stack)

        current_state, path = stack.pop()
        expanded += 1

        current_depth = len(path)
        action_path = " → ".join([move for move, state in path]) if path else "Start"

        path_states = {start}
        for move, state in path:
            path_states.add(state)

        if current_state == goal:
            if len(trace) < MAX_TRACE_ROWS:
                trace.append({
                    "Step": expanded,
                    "Node": state_to_compact(current_state),
                    "State": state_to_grid_html(current_state),
                    "Depth": current_depth,
                    "Action Path": action_path,
                    "Children Added": "Không cần sinh con vì đã tới Goal",
                    "Frontier Before Pop": frontier_before,
                    "Frontier After Expand": format_stack(stack),
                    "Reached": "Không dùng Reached toàn cục",
                    "Path Checking": format_state_list(path_states),
                    "Note": "Tìm thấy Goal"
                })

            solution_states = [start] + [state for move, state in path]
            solution_moves = [move for move, state in path]

            return solution_states, solution_moves, trace, {
                "status": "found",
                "expanded": expanded,
                "visited": generated,
                "depth": current_depth
            }

        if current_depth >= max_depth:
            if len(trace) < MAX_TRACE_ROWS:
                trace.append({
                    "Step": expanded,
                    "Node": state_to_compact(current_state),
                    "State": state_to_grid_html(current_state),
                    "Depth": current_depth,
                    "Action Path": action_path,
                    "Children Added": "Không mở rộng vì đạt max depth",
                    "Frontier Before Pop": frontier_before,
                    "Frontier After Expand": format_stack(stack),
                    "Reached": "Không dùng Reached toàn cục",
                    "Path Checking": format_state_list(path_states),
                    "Note": "Cắt nhánh"
                })
            continue

        neighbors = get_neighbors(current_state)

        children_added = []

        for move_name, next_state in neighbors:
            if next_state not in path_states:
                children_added.append((move_name, next_state))

        for move_name, next_state in reversed(children_added):
            generated += 1
            stack.append((next_state, path + [(move_name, next_state)]))

        children_text = " |\n".join(
            f"{move}: {state_to_compact(state)}"
            for move, state in children_added
        )

        if children_text == "":
            children_text = "Không có con mới"

        if len(trace) < MAX_TRACE_ROWS:
            trace.append({
                "Step": expanded,
                "Node": state_to_compact(current_state),
                "State": state_to_grid_html(current_state),
                "Depth": current_depth,
                "Action Path": action_path,
                "Children Added": children_text,
                "Frontier Before Pop": frontier_before,
                "Frontier After Expand": format_stack(stack),
                "Reached": "Không dùng Reached toàn cục",
                "Path Checking": format_state_list(path_states),
                "Note": "Đã mở rộng node"
            })

    return None, None, trace, {
        "status": "not_found",
        "expanded": expanded,
        "visited": generated,
        "depth": max_depth
    }


