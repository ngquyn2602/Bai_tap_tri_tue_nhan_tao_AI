# ============================================================
# START / GOAL MẶC ĐỊNH
# ============================================================

START_DEFAULT = (1, 2, 3,
                 4, 5, 6,
                 0, 7, 8)

GOAL_DEFAULT = (1, 2, 3,
                4, 5, 6,
                7, 8, 0)


# ============================================================
# HÀM XỬ LÝ 8-PUZZLE
# ============================================================

def parse_state(text):
    nums = list(map(int, re.findall(r"\d+", text)))

    if len(nums) != 9:
        raise ValueError("Phải nhập đúng 9 số.")

    if sorted(nums) != list(range(9)):
        raise ValueError("Trạng thái phải gồm đủ các số từ 0 đến 8 và không được trùng.")

    return tuple(nums)


def state_to_text(state):
    return " ".join(map(str, state))


def state_to_compact(state):
    return f"{state[0]}{state[1]}{state[2]}/{state[3]}{state[4]}{state[5]}/{state[6]}{state[7]}{state[8]}"


def state_to_grid_html(state):
    return f"""
    <div class="state-grid">
        {state[0]} {state[1]} {state[2]}<br>
        {state[3]} {state[4]} {state[5]}<br>
        {state[6]} {state[7]} {state[8]}
    </div>
    """


def swap_positions(state, i, j):
    arr = list(state)
    arr[i], arr[j] = arr[j], arr[i]
    return tuple(arr)


def inversions(state):
    arr = [x for x in state if x != 0]
    count = 0

    for i in range(len(arr)):
        for j in range(i + 1, len(arr)):
            if arr[i] > arr[j]:
                count += 1

    return count


def is_solvable(start, goal):
    return inversions(start) % 2 == inversions(goal) % 2


def get_neighbors(state):
    """
    Thứ tự xét:
    Up, Down, Left, Right

    Hành động là di chuyển ô trống 0.
    """
    blank = state.index(0)
    row, col = divmod(blank, 3)

    directions = [
        ("Up", -1, 0),
        ("Down", 1, 0),
        ("Left", 0, -1),
        ("Right", 0, 1)
    ]

    neighbors = []

    for move_name, dr, dc in directions:
        new_row = row + dr
        new_col = col + dc

        if 0 <= new_row < 3 and 0 <= new_col < 3:
            new_blank = new_row * 3 + new_col
            new_state = swap_positions(state, blank, new_blank)
            neighbors.append((move_name, new_state))

    return neighbors


def format_state_list(states, max_items=8):
    """
    Format danh sách state để đưa vào bảng.
    Mỗi state xuống dòng riêng để bảng không bị kéo ngang quá dài.
    """
    states = list(states)

    if len(states) == 0:
        return "Rỗng"

    shown = states[:max_items]
    lines = [state_to_compact(s) for s in shown]

    if len(states) > max_items:
        lines.append(f"... ({len(states) - max_items} state khác)")

    return " |\n".join(lines)


def format_stack(stack, max_items=8):
    """
    Format Frontier của DFS.
    DFS dùng Stack nên TOP nằm ở bên phải, tức là phần tử cuối của list.
    """
    if not stack:
        return "Rỗng"

    states = [item[0] for item in stack]

    if len(states) <= max_items:
        lines = []
        for i, state in enumerate(states):
            suffix = " ← TOP bên phải" if i == len(states) - 1 else ""
            lines.append(state_to_compact(state) + suffix)
        return " |\n".join(lines)

    bottom_part = states[:max_items - 2]
    lines = [state_to_compact(s) for s in bottom_part]
    lines.append(f"... ({len(states) - len(bottom_part) - 1} state ở giữa)")
    lines.append(state_to_compact(states[-1]) + " ← TOP bên phải")
    return " |\n".join(lines)


def random_solvable_state(goal=GOAL_DEFAULT, steps=RANDOM_STEPS):
    """
    Random từ Goal đi ra vài bước.
    Vì xuất phát từ Goal nên chắc chắn có đường quay về Goal.
    """
    state = goal
    previous_state = None

    for _ in range(steps):
        neighbors = get_neighbors(state)

        if previous_state is not None:
            neighbors = [(m, s) for m, s in neighbors if s != previous_state]

        move, next_state = random.choice(neighbors)
        previous_state = state
        state = next_state

    return state


