class EightPuzzleDFSApp:
    def __init__(self):
        self.current_state = START_DEFAULT
        self.goal_state = GOAL_DEFAULT

        self.solution_states = []
        self.solution_moves = []
        self.solution_table = []
        self.trace_data = []

        self.current_step = 0
        self.current_algorithm = "Chưa chạy"

        self.auto_running = False
        self.run_id = 0

        self.start_input = widgets.Text(
            value=state_to_text(START_DEFAULT),
            description="Start:",
            layout=widgets.Layout(width="760px")
        )

        self.goal_input = widgets.Text(
            value=state_to_text(GOAL_DEFAULT),
            description="Goal:",
            layout=widgets.Layout(width="760px")
        )

        self.mode_select = widgets.Dropdown(
            options=[
                ("DFS Cách 1 - Stack + Reached", "way1"),
                ("DFS Cách 2 - Stack + Path Checking", "way2")
            ],
            value="way1",
            description="Chọn DFS:",
            layout=widgets.Layout(width="760px")
        )

        self.info = widgets.HTML(
            value=f"""
            <p>
            <b>Cấu hình cố định:</b>
            MAX_DEPTH = {MAX_DEPTH},
            RANDOM_STEPS = {RANDOM_STEPS},
            AUTO_SPEED = {AUTO_SPEED} giây/bước,
            DFS Table chỉ hiện {MAX_TRACE_ROWS} dòng đầu và có thanh cuộn để dễ xem.
            </p>
            """
        )

        self.status = widgets.HTML(value="")
        self.solution_output = widgets.Output()
        self.trace_output = widgets.Output()

        self.buttons = []

        for i in range(9):
            btn = widgets.Button(
                description="",
                layout=widgets.Layout(width="90px", height="90px")
            )
            self.buttons.append(btn)

        self.grid = widgets.VBox([
            widgets.HBox(self.buttons[0:3]),
            widgets.HBox(self.buttons[3:6]),
            widgets.HBox(self.buttons[6:9])
        ])

        self.load_btn = widgets.Button(description="Load Start", button_style="info")
        self.random_btn = widgets.Button(description="Random Again", button_style="warning")
        self.solve_btn = widgets.Button(description="Solve DFS", button_style="success")
        self.stop_btn = widgets.Button(description="Stop", button_style="danger")
        self.show_table_btn = widgets.Button(description="Show Tables")
        self.reset_btn = widgets.Button(description="Reset")

        self.load_btn.on_click(self.load_start)
        self.random_btn.on_click(self.random_again)
        self.solve_btn.on_click(self.solve_and_run)
        self.stop_btn.on_click(self.stop_auto)
        self.show_table_btn.on_click(self.show_tables)
        self.reset_btn.on_click(self.reset)

        self.controls = widgets.HBox([
            self.load_btn,
            self.random_btn,
            self.solve_btn,
            self.stop_btn,
            self.show_table_btn,
            self.reset_btn
        ])

        self.app = widgets.VBox([
            widgets.HTML(PEAS_HTML),
            widgets.HTML("<h2>8-Puzzle DFS Interactive App</h2>"),
            widgets.HTML("<p>Nhập Start và Goal bằng 9 số từ 0 đến 8. Số 0 là ô trống.</p>"),
            self.info,
            self.start_input,
            self.goal_input,
            self.mode_select,
            self.grid,
            self.controls,
            self.status,
            self.solution_output,
            self.trace_output
        ])

        self.render_board()

    def render_board(self):
        for i, value in enumerate(self.current_state):
            if value == 0:
                self.buttons[i].description = " "
                self.buttons[i].button_style = "warning"
            else:
                self.buttons[i].description = str(value)
                self.buttons[i].button_style = ""

    def clear_outputs(self):
        with self.solution_output:
            clear_output()

        with self.trace_output:
            clear_output()

    def build_solution_table(self):
        self.solution_table = []

        for i, state in enumerate(self.solution_states):
            move = "Start" if i == 0 else self.solution_moves[i - 1]

            self.solution_table.append({
                "Step": i,
                "Move": move,
                "State Grid": state_to_grid_html(state),
                "State Compact": state_to_compact(state)
            })

    def show_solution_table(self):
        with self.solution_output:
            clear_output()

            if not self.solution_table:
                display(HTML("<p>Chưa có Solution Steps. Hãy bấm <b>Solve DFS</b>.</p>"))
                return

            display(HTML(make_html_table(self.solution_table, "Solution Steps")))

    def show_trace_table(self):
        with self.trace_output:
            clear_output()

            if not self.trace_data:
                display(HTML("<p>Chưa có DFS Table. Hãy bấm <b>Solve DFS</b>.</p>"))
                return

            display(HTML(make_html_table(self.trace_data, "DFS Table: Node / State / Frontier / Reached")))

    def show_tables(self, button=None):
        self.show_solution_table()
        self.show_trace_table()

    def load_start(self, button=None):
        self.stop_auto()

        try:
            self.current_state = parse_state(self.start_input.value)
            self.goal_state = parse_state(self.goal_input.value)

            self.solution_states = []
            self.solution_moves = []
            self.solution_table = []
            self.trace_data = []
            self.current_step = 0

            self.render_board()
            self.clear_outputs()

            self.status.value = f"""
            <b>Đã Load Start.</b><br>
            <b>Start:</b> {state_to_compact(self.current_state)}<br>
            <b>Goal:</b> {state_to_compact(self.goal_state)}<br>
            <b>Inversions Start:</b> {inversions(self.current_state)}<br>
            <b>Inversions Goal:</b> {inversions(self.goal_state)}<br>
            <b>Có thể giải:</b> {"Có" if is_solvable(self.current_state, self.goal_state) else "Không"}
            """

        except Exception as e:
            self.status.value = f"<b>Lỗi:</b> {e}"

    def random_again(self, button=None):
        self.stop_auto()

        try:
            self.goal_state = parse_state(self.goal_input.value)
            self.current_state = random_solvable_state(self.goal_state, RANDOM_STEPS)

            self.start_input.value = state_to_text(self.current_state)

            self.solution_states = []
            self.solution_moves = []
            self.solution_table = []
            self.trace_data = []
            self.current_step = 0

            self.render_board()
            self.clear_outputs()

            self.status.value = f"""
            <b>Đã Random Again.</b><br>
            <b>Start mới:</b> {state_to_compact(self.current_state)}<br>
            <b>Goal:</b> {state_to_compact(self.goal_state)}<br>
            <b>Chắc chắn giải được:</b> Có, vì random từ Goal ra {RANDOM_STEPS} bước.<br>
            Bây giờ bấm <b>Solve DFS</b>.
            """

        except Exception as e:
            self.status.value = f"<b>Lỗi:</b> {e}"

    def solve_selected(self):
        try:
            start = parse_state(self.start_input.value)
            goal = parse_state(self.goal_input.value)

            self.current_state = start
            self.goal_state = goal

            mode = self.mode_select.value

            if mode == "way1":
                self.current_algorithm = "DFS Cách 1 - Stack + Reached"
                solution_states, solution_moves, trace, stats = dfs_way1(start, goal, MAX_DEPTH)
            else:
                self.current_algorithm = "DFS Cách 2 - Stack + Path Checking"
                solution_states, solution_moves, trace, stats = dfs_way2(start, goal, MAX_DEPTH)

            self.trace_data = trace

            if stats["status"] == "unsolvable":
                self.solution_states = []
                self.solution_moves = []
                self.solution_table = []
                self.current_step = 0
                self.render_board()
                self.clear_outputs()

                self.status.value = f"""
                <b>Thuật toán:</b> {self.current_algorithm}<br>
                <b>Kết quả:</b> Không thể giải.<br>
                <b>Lý do:</b> Start và Goal khác tính chẵn/lẻ nghịch thế.<br>
                <b>Start:</b> {state_to_compact(start)}<br>
                <b>Goal:</b> {state_to_compact(goal)}<br>
                <b>Inversions Start:</b> {inversions(start)}<br>
                <b>Inversions Goal:</b> {inversions(goal)}
                """
                return False

            if stats["status"] == "not_found":
                self.solution_states = []
                self.solution_moves = []
                self.solution_table = []
                self.current_step = 0
                self.render_board()

                self.status.value = f"""
                <b>Thuật toán:</b> {self.current_algorithm}<br>
                <b>Kết quả:</b> Chưa tìm thấy lời giải trong MAX_DEPTH = {MAX_DEPTH}.<br>
                <b>Gợi ý:</b> Bài nhập tay có thể quá sâu. Hãy bấm Random Again hoặc tăng MAX_DEPTH trong code.
                """

                self.show_trace_table()
                return False

            self.solution_states = solution_states
            self.solution_moves = solution_moves
            self.current_step = 0
            self.current_state = self.solution_states[0]
            self.render_board()

            self.build_solution_table()

            moves_text = " → ".join(self.solution_moves)

            self.status.value = f"""
            <b>Thuật toán:</b> {self.current_algorithm}<br>
            <b>Kết quả:</b> Tìm thấy lời giải.<br>
            <b>Số bước lời giải:</b> {len(self.solution_moves)} / tối đa {MAX_DEPTH}<br>
            <b>Đường đi:</b> {moves_text}<br>
            <b>Số node DFS đã mở rộng:</b> {stats["expanded"]}<br>
            <b>Lưu ý:</b> Bảng DFS bên dưới chỉ hiện {MAX_TRACE_ROWS} dòng đầu để minh họa.<br>
            <b>Đang chạy tự động...</b>
            """

            self.show_solution_table()
            self.show_trace_table()

            return True

        except Exception as e:
            self.status.value = f"<b>Lỗi:</b> {e}"
            return False

    def animation_loop(self, my_run_id):
        while (
            self.auto_running
            and my_run_id == self.run_id
            and self.current_step < len(self.solution_states) - 1
        ):
            time.sleep(AUTO_SPEED)

            if not self.auto_running or my_run_id != self.run_id:
                break

            self.current_step += 1
            self.current_state = self.solution_states[self.current_step]
            self.render_board()

            move = self.solution_moves[self.current_step - 1]

            self.status.value = f"""
            <b>Đang chạy tự động...</b><br>
            <b>Thuật toán:</b> {self.current_algorithm}<br>
            <b>Step:</b> {self.current_step}/{len(self.solution_states) - 1}<br>
            <b>Move:</b> {move}<br>
            <b>Current State:</b> {state_to_compact(self.current_state)}
            """

        if (
            self.solution_states
            and self.current_step >= len(self.solution_states) - 1
            and my_run_id == self.run_id
        ):
            self.auto_running = False
            self.status.value = f"""
            <b>Chạy xong.</b><br>
            <b>Thuật toán:</b> {self.current_algorithm}<br>
            <b>Goal:</b> {state_to_compact(self.current_state)}
            """

    def solve_and_run(self, button=None):
        self.stop_auto()

        ok = self.solve_selected()

        if not ok:
            return

        if len(self.solution_states) <= 1:
            self.status.value += "<br><b>Start đã là Goal.</b>"
            return

        self.auto_running = True
        self.run_id += 1
        my_run_id = self.run_id

        thread = threading.Thread(target=self.animation_loop, args=(my_run_id,), daemon=True)
        thread.start()

    def stop_auto(self, button=None):
        self.auto_running = False
        self.run_id += 1

        if button is not None:
            self.status.value = "<b>Đã dừng chạy tự động.</b>"

    def reset(self, button=None):
        self.stop_auto()

        self.current_state = START_DEFAULT
        self.goal_state = GOAL_DEFAULT

        self.start_input.value = state_to_text(START_DEFAULT)
        self.goal_input.value = state_to_text(GOAL_DEFAULT)
        self.mode_select.value = "way1"

        self.solution_states = []
        self.solution_moves = []
        self.solution_table = []
        self.trace_data = []

        self.current_step = 0
        self.current_algorithm = "Chưa chạy"

        self.render_board()
        self.clear_outputs()

        self.status.value = "<b>Đã reset về bài mặc định có thể giải được.</b>"

    def show(self):
        display(self.app)


# ============================================================
# CHẠY APP
# ============================================================

app = EightPuzzleDFSApp()
app.show()
